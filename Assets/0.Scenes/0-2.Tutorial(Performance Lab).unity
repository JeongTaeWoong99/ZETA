    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[29]
      value: "\uC2E4\uD5D8 \uAC1C\uCCB4\uC758 \uD1B5\uC81C \uBD88\uC751\uC744 \uD655\uC778.
        \uD574\uB2F9 \uAC1C\uCCB4\uC758 \uBB34\uB825\uD654\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
