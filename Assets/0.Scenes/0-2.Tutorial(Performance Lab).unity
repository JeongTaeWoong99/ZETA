      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0
        \uB530\uB77C\uC11C \uD589\uB3D9\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[18]
      value: "\uBAA8\uB4E0 \uC9C0\uC2DC \uC774\uD589\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[19]
      value: "\uB2E4\uC74C\uC740 [\uD2B9\uBCC4\uD55C \uD798] \uC801\uC751\uB3C4 \uC2E4\uD5D8\uC744
        \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[20]
      value: "\uC2E4\uD5D8\uC744 \uC9C4\uD589\uD558\uAE30 \uC704\uD574\uC11C\uB294
        \uC2E4\uD5D8 \uC9C4\uD589 \uAD8C\uD55C\uC744 \uAC00\uC9C4 \uC218\uC11D \uC5F0\uAD6C\uC6D0
        \uC9C1\uAE09 \uC774\uC0C1\uC758 \uC2B9\uC778\uC774 \uD544\uC694\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[21]
      value: "\uC2E4\uD5D8\uC744 \uC2B9\uC778\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[22]
      value: "\uC9C4\uD589\uD574."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[23]
      value: "\uD574\uB2F9 \uC2E4\uD5D8\uC740 \uC548\uB4DC\uB85C\uC774\uB4DC\uC5D0\uAC8C
        3\uB2E8\uACC4 \uAD8C\uD55C \uC0AC\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[24]
      value: "\uD574\uB2F9 \uAD8C\uD55C\uC774 \uBD80\uC5EC\uB41C \uAC1C\uCCB4\uB294
        \uB192\uC740 \uC790\uC728\uC131\uC744 \uBCF4\uC7A5\uBC1B\uAC8C \uB418\uACE0, 
        \uC774\uB294 \uC608\uAE30\uCE58 \uBABB\uD55C \uB3CC\uBC1C \uC0C1\uD669\uC774
        \uC0DD\uAE38 \uC704\uD5D8\uC774 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[25]
      value: "\uB530\uB77C\uC11C, \uC2E4\uD5D8\uC740 \uC644\uBCBD\uD788 \uD1B5\uC81C\uB41C
        \uC0C1\uD669 \uC18D\uC5D0\uC11C \uC9C4\uD589\uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[26]
      value: "\uC2E4\uD5D8 \uC9C4\uD589 \uC911, \uD1B5\uC81C\uAC00 \uBC97\uC5B4\uB0AC\uB2E4\uACE0
        \uD310\uB2E8\uB418\uB294 \uACBD\uC6B0, \uC81C\uC555 \uBC0F \uD3D0\uAE30\uCC98\uBD84
        \uB420 \uC218 \uC788\uC74C\uC744 \uC54C\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[27]
      value: "Z-1217 \uAC1C\uCCB4\uC5D0 3\uB2E8\uACC4 \uAD8C\uD55C\uC744 \uBD80\uC5EC."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[28]
      value: "Q\uD0A4\uB97C \uB204\uB974\uBA74, [\uD2B9\uBCC4\uD55C \uD798]\uC744
        \uC0AC\uC6A9\uD558\uC5EC, \uC790\uC2E0\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0
        \uBB3C\uCCB4\uC758 \uC2DC\uAC04\uC744 \uB290\uB9AC\uAC8C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[29]
      value: "\uC2E4\uD5D8 \uC900\uBE44\uAC00 \uC644\uB8CC\uB418\uBA74, \uCF58\uC194\uC744
        \uB20C\uB7EC [\uD2B9\uBCC4\uD55C \uD798] \uD65C\uC6A9 \uB2A5\uB825 \uC2E4\uD5D8\uC744
        \uC9C4\uD589\uD558\uC2ED\uC2DC\uC624."
