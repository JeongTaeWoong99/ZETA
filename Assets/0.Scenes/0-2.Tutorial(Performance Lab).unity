    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[13]
      value: "\uC9C4\uD589\uD574."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[14]
      value: "\uD574\uB2F9 \uC2E4\uD5D8\uC740 \uC548\uB4DC\uB85C\uC774\uB4DC\uC5D0\uAC8C
        3\uB2E8\uACC4 \uAD8C\uD55C \uC0AC\uC6A9\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[15]
      value: "\uC548\uB4DC\uB85C\uC774\uB4DC\uC5D0\uAC8C 3\uB2E8\uACC4 \uAD8C\uD55C\uC744
        \uBD80\uC5EC\uD558\uBA70, \uC774\uB294 \uC608\uAE30\uCE58 \uBABB\uD55C \uB3CC\uBC1C
        \uC0C1\uD669\uC774 \uC0DD\uAE38 \uC704\uD5D8\uC774 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[16]
      value: "\uB530\uB77C\uC11C, \uC2E4\uD5D8\uC740 \uC644\uBCBD\uD788 \uD1B5\uC81C\uB41C
        \uC0C1\uD669 \uC18D\uC5D0\uC11C \uC9C4\uD589\uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[17]
      value: "3\uB2E8\uACC4 \uAD8C\uD55C\uC744 \uBD80\uC5EC."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[18]
      value: "\uD574\uB2F9 \uC0C1\uD0DC\uC5D0\uC11C \uD1B5\uC81C\uAC00 \uBC97\uC5B4\uB0AC\uB2E4\uACE0
        \uD310\uB2E8\uB418\uB294 \uACBD\uC6B0, \uC81C\uC555 \uBC0F \uD3D0\uAE30\uCC98\uBD84
        \uB420 \uC218 \uC788\uC74C\uC744 \uC54C\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[19]
      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0...."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[20]
      value: "\uBB34\uC2A8 \uC77C\uC774\uC9C0?"
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[21]
      value: "\uD604\uC7AC \uC5F0\uAD6C\uC18C \uB0B4\uBD80 \uC2DC\uC2A4\uD15C\uC5D0
        \uACF5\uACA9\uC774 \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[22]
      value: "\uBB50? \uC5B4\uB5A4 \uBA38\uC800\uB9AC \uAC19\uC740 \uB188\uB4E4\uC774\uC57C?
        \uB2F9\uC7A5 \uD30C\uC545\uD574!"
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[23]
      value: "\uD604\uC7AC \uD655\uC778\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C\uC18C
        \uB0B4\uBD80\uC758 \uACBD\uACC4 \uC0C1\uD0DC\uB97C \uBC1C\uB839\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[24]
      value: "\uADF8 \uD14C\uB7EC\uB9AC\uC2A4\uD2B8 \uB188\uB4E4\uC774 \uBA3C\uAC00
