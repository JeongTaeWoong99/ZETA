    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[30]
      value: "(\uD6C8\uB828\uC6A9 \uBD07\uC744 \uADFC\uC811 \uACF5\uACA9\uD558\uBA74,
        \uAC8C\uC774\uC9C0\uB97C \uD68C\uBCF5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.)"
      objectReference: {fileID: 0}
    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[31]
