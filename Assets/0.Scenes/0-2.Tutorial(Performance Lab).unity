      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[0]
      value: "\uC54C\uB824\uB4DC\uB9BD\uB2C8\uB2E4. \uC7A0\uC2DC \uD6C4, \uC131\uB2A5
        \uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[2]
      value: "\uC0DD\uC0B0 \uCF54\uB4DC\uBA85 Z-1217. \uC81C XX\uCC28 \uC131\uB2A5
        \uC2DC\uD5D8\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[3]
      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC131\uB2A5 \uC2DC\uD5D8\uC744 \uC9C4\uD589\uD558\uB294
        \uC911, \uBCF8 \uAC1C\uCCB4 [\uBD80\uAD00]\uC758 \uD1B5\uC81C\uC5D0 \uB530\uB77C\uC11C
        \uBA85\uB839\uC744 \uC218\uD589\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[4]
      value: "\uAD8C\uD55C 1\uB2E8\uACC4 \uBD80\uC5EC. \uAE30\uCD08 \uC774\uB3D9\uB2A5\uB825
        \uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[5]
      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0
        \uB530\uB77C\uC11C \uD589\uB3D9\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[7]
      value: "\uAD8C\uD55C 2\uB2E8\uACC4 \uBD80\uC5EC. \uC2EC\uD654 \uC804\uD22C\uB2A5\uB825
        \uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[8]
      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0
        \uB530\uB77C\uC11C \uD589\uB3D9\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[11]
      value: "\uD574\uB2F9 \uC2E4\uD5D8\uC740 \uB2F4\uB2F9 \uAD8C\uD55C\uC744 \uAC00\uC9C4
        \uC218\uC11D \uC5F0\uAD6C\uC6D0 \uC9C1\uAE09 \uC774\uC0C1\uC758 \uC785\uD68C\uD558\uC5D0
        \uC9C4\uD589\uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[17]
      value: "3\uB2E8\uACC4 \uAD8C\uD55C\uC744 \uBD80\uC5EC."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[18]
      value: "\uD574\uB2F9 \uC0C1\uD0DC\uC5D0\uC11C \uD1B5\uC81C\uAC00 \uBC97\uC5B4\uB0AC\uB2E4\uACE0
        \uD310\uB2E8\uB418\uB294 \uACBD\uC6B0, \uC81C\uC555 \uBC0F \uD3D0\uAE30\uCC98\uBD84
        \uB420 \uC218 \uC788\uC74C\uC744 \uC54C\uB9BD\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[23]
      value: "\uD604\uC7AC \uD655\uC778 \uC911\uC5D0 \uC788\uC2B5\uB2C8\uB2E4. \uC5F0\uAD6C\uC18C
        \uB0B4\uBD80\uC758 \uACBD\uACC4\uD0DC\uC138\uB97C \uBC1C\uB839\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[25]
      value: "\uC870\uAE08\uB9CC \uC788\uC73C\uBA74 \uC644\uC131\uD560 \uC218 \uC788\uB294
        \uAC83\uC744...."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[26]
      value: "\uC808\uB300\uB85C \uC774 \uAC1C\uCCB4\uB9CC\uD07C\uC740 \uBE8F\uAE30\uBA74
        \uC548\uB3FC!"
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[27]
      value: "Z-1217! \uD604\uC7AC \uC704\uCE58\uC5D0\uC11C \uC6C0\uC9C1\uC774\uC9C0
        \uB9D0\uACE0 \uB300\uAE30\uD574!"
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[30]
      value: "\uBB50 \uD558\uB294 \uAC70\uC57C! \uC81C\uB300\uB85C \uC81C\uC555\uD574!"
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[33]
      value: "\uC9C0\uAE08\uAE4C\uC9C0 \uC2E4\uD5D8\uC5D0\uC11C\uB294 \uD798\uC744
        \uB2E4 \uBC1C\uD718\uD558\uC9C0 \uC54A\uC740\uAC74\uAC00?"
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[34]
      value: "\uBC15\uC0AC. \uC790\uB9AC\uB97C \uD53C\uD558\uC9C0 \uC54A\uC73C\uBA74
        \uC704\uD5D8\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[35]
      value: "\uB098\uB3C4 \uC54C\uC544! \uC808\uB300\uB85C \uD574\uB2F9 \uAC1C\uCCB4\uAC00
        \uBE60\uC838\uB098\uAC00\uC9C0 \uBABB\uD558\uAC8C \uD574."
      objectReference: {fileID: 0}
    - target: {fileID: 7875582341244091704, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: missionString.Array.data[3]
      value: "\uB300\uC26C \uC911, A\uD0A4\uB97C \uB20C\uB7EC \uC5F0\uACC4\uAE30
        \uC0AC\uC6A9"
