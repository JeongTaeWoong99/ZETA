    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[2]
      value: "\uC0DD\uC0B0 \uCF54\uB4DC\uBA85 Z-1217. \uC81C XX\uCC28 \uC131\uB2A5
        \uC2E4\uD5D8\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[3]
      value: "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC131\uB2A5 \uC2E4\uD5D8\uC744 \uC9C4\uD589\uD560
        \uB3D9\uC548 \uBCF8 \uAC1C\uCCB4 [\uBD80\uAD00]\uC758 \uD1B5\uC81C\uC5D0
        \uB530\uB77C, \uBA85\uB839\uC744 \uC218\uD589\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 167749134127184477, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[4]
      value: "\uAD8C\uD55C 1\uB2E8\uACC4 \uBD80\uC5EC. \uAE30\uCD08 \uC774\uB3D9\uB2A5\uB825
        \uC2DC\uD5D8\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
