    - target: {fileID: 6932065411140394711, guid: 1173e0befe6dbf24c8b05625af986198, type: 3}
      propertyPath: dialogString.Array.data[33]
      value: "\uC2E4\uD5D8 \uC2E4\uD328. \uC2E4\uD5D8\uC744 \uB2E4\uC2DC \uC9C4\uD589\uD558\uC2DC\uAE38
