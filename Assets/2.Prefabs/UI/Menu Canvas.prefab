  m_text: "\uBCF8\uC778\uC758 \uC18D\uB3C4\uB97C \uAC00\uC18D\uD558\uC5EC, \uB2E4\uB978
    \uC678\uBD80 \uC694\uC778\uB4E4\uC758 \uC18D\uB3C4\uB97C \uC0C1\uB300\uC801\uC73C\uB85C
    \uB290\uB9AC\uAC8C \uB9CC\uB4ED\uB2C8\uB2E4.\n\n\uC0AC\uC6A9\uD558\uAE30 \uC704\uD574\uC11C,
    \uCD5C\uC18C 10\uC758 \uAC8C\uC774\uC9C0\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.\n\n\uAC00\uC18D
    \uC911, \uAC8C\uC774\uC9C0\uAC00 \uCC9C\uCC9C\uD788 \uC904\uC5B4\uB4ED\uB2C8\uB2E4.\n\n\uAC00\uC18D
    \uC911, Q\uB97C \uB2E4\uC2DC \uB204\uB974\uBA74, \uAC00\uC18D\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4."
