  titleImage: {fileID: 5565296756060113097}
  titleText: {fileID: 3068304521904457416}
  titleString: 
  dialogFaceFrameList:
  - {fileID: 2670117241403767869}
  - {fileID: 1105257202805803979}
  dialogFaceList:
  - {fileID: 2692667079426523911}
  - {fileID: 5556956076898862542}
  dialogTextFrameList:
  - {fileID: 2614720537449167954}
  - {fileID: 5771361564829835093}
  dialogNpcTextList:
  - {fileID: 5328218143420522094}
  - {fileID: 1254298687834480764}
  dialogNpcNameString:
  - "\uBD80\uAD00"
  - "\uBC15\uC0AC"
  dialogTextList:
  - {fileID: 5730512974191422552}
  - {fileID: 7024752641738340939}
  dialogEnterList:
  - {fileID: 1929011503689087495}
  - {fileID: 5593507717532521758}
  dialogString:
  - "\uC54C\uB824\uB4DC\uB9BD\uB2C8\uB2E4. \uC7A0\uC2DC \uD6C4, \uC131\uB2A5 \uC2E4\uD5D8\uC744
    \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uC2DC\uC791\uD574."
  - "\uC0DD\uC0B0 \uCF54\uB4DC\uBA85 Z-1217, \uC81C XX\uCC28 \uC131\uB2A5 \uC2E4\uD5D8\uB97C
    \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC131\uB2A5 \uC2E4\uD5D8\uC744 \uC9C4\uD589\uD560
    \uB3D9\uC548 \uBCF8 \uAC1C\uCCB4 [\uBD80\uAD00]\uC758 \uD1B5\uC81C\uC5D0 \uB530\uB77C,
    \uBA85\uB839\uC744 \uC218\uD589\uD569\uB2C8\uB2E4."
  - "\uAE30\uCD08 \uC774\uB3D9\uB2A5\uB825 \uC2E4\uD5D8\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0
    \uB530\uB77C, \uD589\uB3D9\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - "\uBAA8\uB4E0 \uC9C0\uC2DC \uC774\uD589\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uC74C\uC740 \uC2EC\uD654 \uC774\uB3D9\uB2A5\uB825 \uC2DC\uD5D8\uC744
    \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0
    \uB530\uB77C, \uD589\uB3D9\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - "\uBAA8\uB4E0 \uC9C0\uC2DC \uC774\uD589\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - "\uB2E4\uC74C\uC740 [\uD2B9\uBCC4\uD55C \uD798] \uC801\uC751\uB3C4 \uC2E4\uD5D8\uC744
    \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uD574\uB2F9 \uC2E4\uD5D8\uC740 \uB2F4\uB2F9 \uAD8C\uD55C\uC744 \uAC00\uC9C4,
    \uC218\uC11D \uC5F0\uAD6C\uC6D0 \uC9C1\uAE09 \uC774\uC0C1\uC758 \uC785\uD68C\uD558\uC5D0
    \uC9C4\uD589\uB429\uB2C8\uB2E4."
  - "\uC2E4\uD5D8\uC744 \uC2B9\uC778\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - "\uC9C4\uD589\uD574."
  - "\uD574\uB2F9 \uC2E4\uD5D8\uC740 \uC548\uB4DC\uB85C\uC774\uB4DC\uC5D0\uAC8C \uB192\uC740
    \uC218\uC900\uC758 \uC790\uC728\uAD8C\uC744 \uC694\uAD6C\uD569\uB2C8\uB2E4."
  - "\uC548\uB4DC\uB85C\uC774\uB4DC\uC5D0\uAC8C 3\uB2E8\uACC4 \uC218\uC900\uC758
    \uC790\uC728\uAD8C\uC744 \uBD80\uC5EC\uD558\uBA70, \uC774\uB294 \uC608\uAE30\uCE58
    \uBABB\uD55C \uB3CC\uBC1C \uC0C1\uD669\uC774 \uC0DD\uAE38 \uC704\uD5D8\uC774
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB530\uB77C\uC11C, \uC2E4\uD5D8\uC740 \uC644\uBCBD\uD788 \uD1B5\uC81C\uB41C
    \uC0C1\uD669 \uC18D\uC5D0\uC11C \uC9C4\uD589\uB429\uB2C8\uB2E4."
  - "Z-1217 \uAC1C\uCCB4\uC5D0 3\uB2E8\uACC4 \uC790\uC728\uAD8C\uC744 \uBD80\uC5EC\uD569\uB2C8\uB2E4"
  - "\uD574\uB2F9 \uC0C1\uD0DC\uC5D0\uC11C, \uD1B5\uC81C\uAC00 \uBC97\uC5B4\uB0AC\uB2E4\uACE0
    \uD310\uB2E8\uB418\uB294 \uACBD\uC6B0, \uC81C\uC555 \uBC0F \uD3D0\uAE30\uCC98\uBD84
    \uB420 \uC218 \uC788\uC74C\uC744 \uC54C\uB9BD\uB2C8\uB2E4."
  - "\uB300\uC0C1 \uAC1C\uCCB4\uB294 \uC6B0\uCE21 \uC0C1\uB2E8 \uC9C0\uC2DC\uC5D0...."
  - "\uBB34\uC2A8 \uC77C\uC774\uC9C0???"
  - "\uD604\uC7AC \uC5F0\uAD6C\uC18C \uB0B4\uBD80 \uC2DC\uC2A4\uD15C\uC5D0 \uACF5\uACA9\uC774
    \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uBB50? \uC5B4\uB5A4 \uBA38\uC800\uB9AC \uAC19\uC740 \uB188\uB4E4\uC774\uC57C?
    \uB2F9\uC7A5 \uD30C\uC545\uD574!"
  - "\uD604\uC7AC \uD655\uC778 \uC911\uC5D0 \uC788\uC2B5\uB2C8\uB2E4, \uC5F0\uAD6C\uC18C
    \uB0B4\uBD80\uC758 \uACBD\uACC4 \uC0C1\uD0DC\uB97C \uBC1C\uB839\uD569\uB2C8\uB2E4."
  - "\uADF8 \uD14C\uB7EC\uB9AC\uC2A4\uD2B8 \uB188\uB4E4\uC774 \uBA3C\uAC00 \uB0C4\uC0C8\uB97C
    \uB9E1\uC740 \uAC74\uAC00?"
  - "\uACE7 \uC788\uC73C\uBA74, \uC644\uC131\uD560 \uC218 \uC788\uB294 \uAC83\uC744...."
  - "\uC808 \uB54C, \uC774 \uAC1C\uCCB4\uB9CC\uD07C\uC740 \uBE8F\uAE30\uBA74 \uC548\uB3FC!"
  - "Z-1217 \uD604\uC7AC \uC704\uCE58\uC5D0\uC11C \uC6C0\uC9C1\uC774\uC9C0 \uB9D0\uACE0
    \uB300\uAE30\uD574!"
  - "Z-1217! \uC6C0\uC9C1\uC774\uC9C0 \uB9D0\uB77C\uB294 \uBA85\uB839\uC744 \uB4E3\uC9C0
    \uBABB\uD588\uB098?"
  - "Z-1217 \uAC1C\uCCB4\uC758 \uD1B5\uC81C \uBD88\uC751\uC744 \uD655\uC778. \uD574\uB2F9
    \uAC1C\uCCB4\uC758 \uBB34\uB825\uD654\uB97C \uC9C4\uD589\uD569\uB2C8\uB2E4."
  - "\uBB50 \uD558\uB294 \uAC70\uC57C \uC81C\uB300\uB85C \uC81C\uC555\uD574!"
  - '!!!!!'
  - "\uC774 \uC815\uB3C4\uC77C \uC904\uC774\uC57C?"
  - "\uC9C0\uAE08\uAE4C\uC9C0 \uC2E4\uD5D8\uC5D0\uC11C\uB294 \uD798\uC744 \uB2E4
    \uBC1C\uD718\uD558\uC9C0 \uC54A\uC740\uAC74\uAC00??"
  - "\uBC15\uC0AC. \uC790\uB9AC\uB97C \uD53C\uD558\uC9C0 \uC54A\uC73C\uBA74, \uC704\uD5D8\uD569\uB2C8\uB2E4."
  - "\uB098\uB3C4 \uC54C\uC544! \uC808 \uB54C, \uD574\uB2F9 \uAC1C\uCCB4\uAC00 \uBE60\uC838\uB098\uAC00\uC9C0
    \uBABB\uD558\uAC8C \uD574."
